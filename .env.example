# Copy to .env on the server. Do not commit .env.

# Host port mapped to the container (default 8080)
PORT=8080

# Git branch used by scripts/update.sh
GIT_BRANCH=main

# Optional: SharePoint app-only secret (also set under Setup → SharePoint)
SHAREPOINT_CLIENT_SECRET=

# Shared Postgres (Docker Compose service `db`)
POSTGRES_DB=frx
POSTGRES_USER=frx
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://frx:change-me@db:5432/frx
